# HUX edge-function SECRETS (copy to supabase/functions/.env and fill in).
# Upload with:  supabase secrets set --env-file supabase/functions/.env
# NEVER commit the real file. Names must NOT start with SUPABASE_ (reserved;
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are provided
# to functions automatically).

# AI provider: groq (default) or anthropic
AI_PROVIDER=groq
# Groq console → API Keys (gsk_...)
GROQ_API_KEY=
# Only if AI_PROVIDER=anthropic: Anthropic console → API keys (sk-ant-...)
ANTHROPIC_API_KEY=
# Model ids (check the provider's model list). MEAL_MODEL must accept images.
COACH_MODEL=openai/gpt-oss-120b
MEAL_MODEL=qwen/qwen3.8-27b
# Coach messages per user per day
COACH_DAILY_LIMIT=30
# Meal photo analyses per user per day
MEAL_DAILY_LIMIT=20

# Sign in with Apple token revocation on account delete (Apple Developer →
# Keys → a key with "Sign in with Apple"). Paste the whole .p8 file content.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_BUNDLE_ID=in.co.hux.huxApp
APPLE_PRIVATE_KEY=

# Only if your project has NO legacy anon/service_role keys (new API keys
# only): Supabase → API Keys → publishable + secret key.
HUX_PUBLISHABLE_KEY=
HUX_SECRET_KEY=
