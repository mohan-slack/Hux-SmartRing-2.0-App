# HUX app — CLIENT config (copy to .env and fill in).
# Compiled INTO the app: put only values that are safe to ship in an app.
# NEVER put the service-role/secret key, DB password, Anthropic key or
# Apple .p8 key here — those go in supabase/functions/.env.
#
# Run:   flutter run --dart-define-from-file=.env
# Build: flutter build appbundle --release --dart-define-from-file=.env
#        flutter build ipa --release --dart-define-from-file=.env

# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_...)
SUPABASE_PUBLISHABLE_KEY=

# Google Cloud → Credentials → OAuth 2.0 Client IDs → the "Web client" ID
# (also paste it in Supabase → Authentication → Providers → Google).
# Leave empty to hide Google sign-in.
GOOGLE_WEB_CLIENT_ID=

# Google Cloud → Credentials → the "iOS" client ID. Needed for Google
# sign-in on iPhone. ALSO add its reversed form
# (com.googleusercontent.apps.XXXX) as a URL scheme in
# ios/Runner/Info.plist (CFBundleURLTypes) — otherwise the Google SDK
# crashes. Leave empty to hide Google on iOS.
GOOGLE_IOS_CLIENT_ID=

# Optional: Open-Meteo commercial API key (free tier is NON-commercial only).
OPEN_METEO_API_KEY=

# Optional: data source override — health (release default) | mock | aizo
# HUX_SOURCE=health
