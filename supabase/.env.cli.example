# Supabase CLI login/link values (copy to supabase/.env.cli). Used ONLY on
# your Mac for `supabase link` / `supabase db push`. Never commit.
#
#   set -a; source supabase/.env.cli; set +a
#   supabase link --project-ref "$SUPABASE_PROJECT_REF" --password "$SUPABASE_DB_PASSWORD"
#   supabase db push
#   supabase secrets set --env-file supabase/functions/.env
#   supabase functions deploy analyze-meal coach-chat coach-report delete-account

# Supabase dashboard URL: https://supabase.com/dashboard/project/<this>
SUPABASE_PROJECT_REF=
# Account → Access Tokens (lets the CLI act for your account)
SUPABASE_ACCESS_TOKEN=
# Project Settings → Database → database password
SUPABASE_DB_PASSWORD=
